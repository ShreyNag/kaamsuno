# KaamSuno settings. Copy this file to .env and fill in the values. Never commit .env.
# Lines starting with # are comments; a commented-out VAR=... line shows the default used when it's not set.

# --- Required --------------------------------------------------------------------------------------------
# Gnani API key: Prisma (speech-to-text) and Timbre (text-to-speech). From your Gnani dashboard.
GNANI_API_KEY=
# Groq API key for the interpreter LLM (openai/gpt-oss-20b). Free key at https://console.groq.com/keys.
# Free-tier limits are per key, so everyone should use their own.
GROQ_API_KEY=

# --- Supervisor channel ----------------------------------------------------------------------------------
# Where confirmed reports and emergency alerts go: telegram or whatsapp.
# NOTIFY_CHANNEL=telegram
# Telegram bot token: message @BotFather, send /newbot, copy the token it gives you.
TELEGRAM_BOT_TOKEN=
# The chat the bot posts to: message your bot once, open https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy "chat":{"id": ...}. Group chat IDs are negative; keep the minus sign.
TELEGRAM_CHAT_ID=

# --- Optional: WhatsApp through the Twilio sandbox (only with NOTIFY_CHANNEL=whatsapp) ----------------------
# Twilio console > Account info. The supervisor's phone must first send "join <code>" to the sandbox number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# The supervisor's WhatsApp number, e.g. whatsapp:+91XXXXXXXXXX
SUPERVISOR_WHATSAPP_TO=

# --- Optional: behaviour (app/config.py has every other knob; each can be set here by name) ---------------
# Voice activity detection: silero | custom | composite
# VAD_MODE=silero
# End-of-turn decision: smart_turn_fillers | smart_turn | fixed_timeout
# TURN_MODE=smart_turn_fillers
# Startup check that streams a test clip to Prisma (set 0 to skip; the bot then can't tell if it's deaf)
# PRISMA_SELF_TEST=1
