GNANI_API_KEY=
# LLM for the interpreter (provider/model live in app/config.py, overridable here)
GROQ_API_KEY=
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-20b
# Turn taking (app/config.py has the rest)
# TURN_MODE=smart_turn          # or fixed_timeout
# FIXED_TIMEOUT_MS=700
# SMART_TURN_THRESHOLD=0.5
# Supervisor channel: a Telegram bot (@BotFather -> /newbot) and the chat it posts to
# (message the bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...})
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Or WhatsApp through the Twilio sandbox: NOTIFY_CHANNEL=whatsapp (default telegram). The supervisor's phone
# must first send "join <code>" to the sandbox number (Twilio console > Messaging > Try it out > WhatsApp).
# NOTIFY_CHANNEL=telegram
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
SUPERVISOR_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
